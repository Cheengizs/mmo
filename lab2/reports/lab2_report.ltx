\begin{lstlisting}[language=Python, caption={Импорт библиотек и загрузка датасета (Задание 1)}]
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Задание 1: Загрузка набора данных
df = pd.read_csv('../data/StudentPerformanceFactors.csv')
print("Тип загруженного объекта:", type(df))
print("Размерность датасета (строк, столбцов):", df.shape)
print("\nПервые строки датасета:")
print(df.head())
\end{lstlisting}

\begin{lstlisting}[language=Python, caption={Диагностика, заполнение пропусков и удаление выбросов (Задание 2)}]
# 1. Диагностика пропусков
null_counts = df.isna().sum()
print("Количество пропусков по признакам:\n", null_counts[null_counts > 0])

# Визуализация исходного распределения с выбросами
plt.figure(figsize=(8, 4))
sns.boxplot(x=df['Hours_Studied'], color='skyblue')
plt.title("BoxPlot для Hours_Studied (до очистки)")
plt.show()

# 2. Заполнение пропусков модой для категориальных признаков
columns_with_nulls = ['Teacher_Quality', 'Parental_Education_Level', 'Distance_from_Home']
for col in columns_with_nulls:
    mode_value = df[col].mode()[0]
    df[col] = df[col].fillna(mode_value)
    print(f"Столбец '{col}' заполнен значением: {mode_value}")

print("Всего пропусков в таблице после импутации:", df.isna().sum().sum())

# 3. Устранение выбросов по методу межквартильного размаха (IQR)
print("\nРазмер датасета ДО удаления выбросов:", df.shape)
for col in ['Hours_Studied', 'Exam_Score']:
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    df = df[(df[col] >= lower_bound) & (df[col] <= upper_bound)]

print("Размер датасета ПОСЛЕ удаления выбросов:", df.shape)

# 4. Графическая верификация отсутствия пропусков и выбросов
plt.figure(figsize=(10, 3))
sns.heatmap(df.isna(), cbar=False, yticklabels=False, cmap='viridis')
plt.title("Графическая проверка: пропуски полностью отсутствуют")
plt.show()

plt.figure(figsize=(8, 3))
sns.boxplot(x=df['Hours_Studied'], color='skyblue')
plt.title("Графическая проверка: BoxPlot для Hours_Studied БЕЗ выбросов")
plt.show()
\end{lstlisting}

\begin{lstlisting}[language=Python, caption={Конструирование признаков и кодирование категорий (Задание 3)}]
# 1. Feature Engineering: генерация новых информативных признаков
# Признак 1: Общая учебная нагрузка (самостоятельные часы + репетитор с весом 1.5)
df['Total_Study_Effort'] = (df['Hours_Studied'] + (df['Tutoring_Sessions'] * 1.5)).round(1)

# Признак 2: Ожидаемый потенциал успеваемости (прошлые баллы, взвешенные по посещаемости)
df['Attendance_Weighted_Score'] = ((df['Attendance'] / 100) * df['Previous_Scores']).round(2)

# Признак 3: Баланс учебы и сна (доля часов учебы относительно недельного объема сна)
df['Study_to_Sleep_Ratio'] = (df['Hours_Studied'] / (df['Sleep_Hours'] * 7)).round(3)

print("Примеры значений сгенерированных признаков:")
print(df[['Hours_Studied', 'Tutoring_Sessions', 'Total_Study_Effort', 
          'Attendance_Weighted_Score', 'Study_to_Sleep_Ratio']].head())

# 2. Бинарное кодирование (0 / 1)
binary_cols_yes_no = ['Extracurricular_Activities', 'Internet_Access', 'Learning_Disabilities']
for col in binary_cols_yes_no:
    df[col] = df[col].map({'Yes': 1, 'No': 0})
df['School_Type'] = df['School_Type'].map({'Public': 0, 'Private': 1})
df['Gender'] = df['Gender'].map({'Male': 0, 'Female': 1})

# 3. Порядковое кодирование (Ordinal Encoding)
ordinal_mappings = {
    'Parental_Involvement': {'Low': 0, 'Medium': 1, 'High': 2},
    'Access_to_Resources':  {'Low': 0, 'Medium': 1, 'High': 2},
    'Motivation_Level':     {'Low': 0, 'Medium': 1, 'High': 2},
    'Family_Income':        {'Low': 0, 'Medium': 1, 'High': 2},
    'Teacher_Quality':      {'Low': 0, 'Medium': 1, 'High': 2},
    'Distance_from_Home':   {'Near': 0, 'Moderate': 1, 'Far': 2}
}
for col, mapping in ordinal_mappings.items():
    df[col] = df[col].map(mapping)

# 4. One-Hot Encoding для номинальных категорий
nominal_cols = ['Peer_Influence', 'Parental_Education_Level']
df = pd.get_dummies(df, columns=nominal_cols, drop_first=True, dtype=int)

print("\nРазмерность таблицы после кодирования признаков:", df.shape)
\end{lstlisting}

\begin{lstlisting}[language=Python, caption={Масштабирование данных и визуализация распределений (Задание 4)}]
from sklearn.preprocessing import MinMaxScaler, StandardScaler

# Разделение матрицы признаков и целевой переменной
X = df.drop(columns=['Exam_Score'])
y = df['Exam_Score']

numeric_features = [
    'Hours_Studied', 'Attendance', 'Sleep_Hours', 'Previous_Scores',
    'Tutoring_Sessions', 'Physical_Activity', 'Total_Study_Effort',
    'Attendance_Weighted_Score', 'Study_to_Sleep_Ratio'
]

# 1. Нормализация (MinMaxScaler: сжатие в [0, 1])
min_max_scaler = MinMaxScaler()
X_normalized = X.copy()
X_normalized[numeric_features] = min_max_scaler.fit_transform(X[numeric_features])
print("Параметры нормализованных признаков:")
print(X_normalized[numeric_features].describe().loc[['min', 'max']])

# 2. Стандартизация (StandardScaler: mu ~ 0, sigma ~ 1)
std_scaler = StandardScaler()
X_standardized = X.copy()
X_standardized[numeric_features] = std_scaler.fit_transform(X[numeric_features])
print("\nПараметры стандартизированных признаков:")
print(X_standardized[numeric_features].describe().round(3).loc[['mean', 'std']])

# 3. Визуальное сравнение распределений
fig, axes = plt.subplots(1, 3, figsize=(15, 4))
sns.histplot(X['Previous_Scores'], kde=True, ax=axes[0], color='royalblue', bins=20)
axes[0].set_title('Исходный признак\n(Previous_Scores: шкала [40, 100])')
sns.histplot(X_normalized['Previous_Scores'], kde=True, ax=axes[1], color='forestgreen', bins=20)
axes[1].set_title('Нормализация (MinMaxScaler)\n(Шкала строго [0, 1])')
sns.histplot(X_standardized['Previous_Scores'], kde=True, ax=axes[2], color='crimson', bins=20)
axes[2].set_title('Стандартизация (StandardScaler)\n(Центр 0, разброс [-3, 3])')
plt.tight_layout()
plt.show()
\end{lstlisting}

