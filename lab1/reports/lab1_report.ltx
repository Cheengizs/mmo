# --- Задание 1: Класс односвязного списка ---
class cheengizsList:
    value = None
    nextElem = None

    def __init__(self, *elements):
        self.value = None
        self.nextElem = None
        for el in elements:
            self.append(el)

    def append(self, val):
        if self.value is None and self.nextElem is None:
            self.value = val
            return
        curr = self
        while curr.nextElem is not None:
            curr = curr.nextElem
        new_node = cheengizsList()
        new_node.value = val
        curr.nextElem = new_node

    def prepend(self, val):
        if self.value is None and self.nextElem is None:
            self.value = val
            return
        new_node = cheengizsList()
        new_node.value = self.value
        new_node.nextElem = self.nextElem
        self.value = val
        self.nextElem = new_node

    def insert(self, index, val):
        if index < 0 or index > self.size():
            raise IndexError("Индекс выходит за границы списка")
        if index == 0:
            self.prepend(val)
            return
        curr = self
        for _ in range(index - 1):
            curr = curr.nextElem
        new_node = cheengizsList()
        new_node.value = val
        new_node.nextElem = curr.nextElem
        curr.nextElem = new_node

    def remove(self, val):
        if self.value == val:
            if self.nextElem is not None:
                self.value = self.nextElem.value
                self.nextElem = self.nextElem.nextElem
            else:
                self.value = None
            return True
        curr = self
        while curr.nextElem is not None:
            if curr.nextElem.value == val:
                curr.nextElem = curr.nextElem.nextElem
                return True
            curr = curr.nextElem
        raise ValueError(f"{val} не найден")

    def get(self, index):
        curr, idx = self, 0
        while curr is not None and curr.value is not None:
            if idx == index:
                return curr.value
            curr = curr.nextElem
            idx += 1
        raise IndexError("Индекс вне диапазона")

    def find(self, val):
        curr, idx = self, 0
        while curr is not None and curr.value is not None:
            if curr.value == val:
                return idx
            curr = curr.nextElem
            idx += 1
        return -1

    def size(self):
        if self.value is None and self.nextElem is None:
            return 0
        count, curr = 0, self
        while curr is not None and curr.value is not None:
            count += 1
            curr = curr.nextElem
        return count

    def reverse(self):
        elements = self.to_list()
        elements.reverse()
        self.clear()
        for x in elements:
            self.append(x)

    def clear(self):
        self.value = None
        self.nextElem = None

    def to_list(self):
        res, curr = [], self
        while curr is not None and curr.value is not None:
            res.append(curr.value)
            curr = curr.nextElem
        return res

    def __str__(self):
        lst = self.to_list()
        return " -> ".join(map(str, lst)) if lst else "Пустой список"

# --- Задание 2: Иерархия транспортных средств ---
class Vehicle:
    def __init__(self, name, speed, cost_per_km):
        self.name = name
        self.speed = speed
        self.cost_per_km = cost_per_km

    def calculate_time(self, distance):
        return distance / self.speed

    def calculate_cost(self, distance):
        return distance * self.cost_per_km

    def get_trip_info(self, from_city, to_city, distance):
        return {
            "vehicle": self.name,
            "route": f"{from_city} -> {to_city}",
            "distance_km": distance,
            "time_hours": round(self.calculate_time(distance), 2),
            "cost_rub": round(self.calculate_cost(distance), 2)
        }

class Airplane(Vehicle):
    def __init__(self, name="Самолет", speed=800, cost_per_km=12.0):
        super().__init__(name, speed, cost_per_km)

class Train(Vehicle):
    def __init__(self, name="Поезд", speed=100, cost_per_km=3.5):
        super().__init__(name, speed, cost_per_km)

class Car(Vehicle):
    def __init__(self, name="Автомобиль", speed=90, cost_per_km=5.5):
        super().__init__(name, speed, cost_per_km)

# --- Задание 3: Каталог библиотеки ---
class Book:
    def __init__(self, title, author, year):
        self._title = title
        self._author = author
        self._year = year

    @property
    def title(self):
        return self._title

    @title.setter
    def title(self, new_title):
        if not new_title:
            raise ValueError("Название не может быть пустым")
        self._title = new_title

    def __str__(self):
        return f"«{self._title}» ({self._author}, {self._year})"

class Department:
    def __init__(self, name):
        self._name = name
        self._books = []

    def add_book(self, book):
        self._books.append(book)

    def remove_book(self, title):
        for i, b in enumerate(self._books):
            if b.title.lower() == title.lower():
                return self._books.pop(i)
        return None

    def change_book_title(self, old_title, new_title):
        for b in self._books:
            if b.title.lower() == old_title.lower():
                b.title = new_title
                return True
        return False

    def __str__(self):
        res = f"Отдел: {self._name} ({len(self._books)} книг)\n"
        for i, b in enumerate(self._books, 1):
            res += f"   {i}. {b}\n"
        return res

class Library:
    def __init__(self, name):
        self._name = name
        self._departments = {}

    def add_department(self, dept):
        self._departments[dept._name] = dept

    def save_to_file(self, filename="library_catalog.txt"):
        with open(filename, "w", encoding="utf-8") as f:
            f.write(f"=== Библиотека: {self._name} ===\n\n")
            for dept in self._departments.values():
                f.write(str(dept) + "\n")
