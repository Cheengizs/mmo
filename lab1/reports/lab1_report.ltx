# --- Задание 1: Проверка надежности пароля ---
def is_password_good(password):
    try:
        if len(password) < 10:
            return False
        if not any(symb.isupper() for symb in password):
            return False
        if not any(symb.islower() for symb in password):
            return False
        return True
    except TypeError as e:
        print("Ошибка: неверный тип аргумента:", e)
        return False
    except Exception as e:
        print("Непредвиденная ошибка:", e)
        return False
    finally:
        print("Проверка пароля завершена.")

print("Результат проверки:", is_password_good('PIUBIUBAFIUeB'))

# --- Задание 2: Функция с переменным типом аргумента ---
def diffTypeFunction(a):
    try:
        if type(a) == tuple:
            print("Tuple:")
            for i in a:
                print("len of", i, "is", len(i))
        elif type(a) == list:
            print("List:")
            isNegativeFound = False
            sumAfterNegatvie = 0
            for i in range(len(a)):
                if isNegativeFound:
                    sumAfterNegatvie += a[i]
                elif a[i] < 0:
                    isNegativeFound = True
            print("sum after negative:", sumAfterNegatvie)
        elif type(a) == int:
            numStr = str(a)
            print("amount of even digits:", sum(1 for c in numStr if c in "02468"))
        elif type(a) == str:
            wordNumArr = a.split()
            numberSum = sum(int(w) for w in wordNumArr if w.isnumeric())
            print("sum of numbers in string:", numberSum)
    except TypeError as e:
        print("Ошибка типа данных:", e)
    finally:
        print("Обработка завершена.")

diffTypeFunction(("apple", "banana", "kiwi"))
diffTypeFunction([1, 2, -3, 4, 5])
diffTypeFunction(24681)
diffTypeFunction("some 10 20 words")

# --- Задание 3: Перестановка столбцов матрицы ---
def changeIandJcolumnsInMatrix(matrix, i, j):
    try:
        for row in matrix:
            row[i - 1], row[j - 1] = row[j - 1], row[i - 1]
    except IndexError as e:
        print("Ошибка индекса столбца:", e)
    finally:
        print("Операция перестановки столбцов завершена.")

matrix = [[1, 2, 3], [4, 5, 6]]
print("Исходная матрица:", matrix)
changeIandJcolumnsInMatrix(matrix, 1, 3)
print("Матрица после перестановки:", matrix)

